# Postgres (Vercel Postgres / Neon)
# Vercel Postgres integration injects POSTGRES_PRISMA_URL / POSTGRES_URL_NON_POOLING —
# map them to these two names, or use your own Neon connection strings.
DATABASE_URL="postgres://user:password@host/db?sslmode=require&pgbouncer=true"
DIRECT_URL="postgres://user:password@host/db?sslmode=require"

# Google Drive OAuth (personal account — service accounts have no Drive storage quota)
GOOGLE_OAUTH_CLIENT_ID="xxxx.apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_SECRET="xxxx"
# Obtained once by visiting /api/admin/drive-auth after deploying and logging into /admin
GOOGLE_DRIVE_REFRESH_TOKEN="xxxx"
GOOGLE_DRIVE_ROOT_FOLDER_ID="drive-folder-id-owned-by-the-connected-account"

# Cron protection (Vercel Cron sends this as a Bearer token automatically when set)
CRON_SECRET="generate-a-random-string"

# Admin screen passcode
ADMIN_PASSCODE="generate-a-pin-or-passphrase"
